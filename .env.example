# Kaggle dataset identifier in the form "owner/dataset-name".
KAGGLE_DATASET=owner/dataset-name

# Optional: download only one file from the dataset.
# KAGGLE_FILE=data.csv

# Optional when the Kaggle CLI is not already authenticated.
# Never commit real credentials. Prefer KAGGLE_API_TOKEN or ~/.kaggle/kaggle.json.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
