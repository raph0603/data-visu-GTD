{
  "name": "gtd-viz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:download": "node --env-file=.env scripts/download-kaggle.mjs",
    "test": "vitest run",
    "coverage:tasks": "tsx scripts/coverage-report.ts",
    "coverage:tasks:strict": "tsx scripts/coverage-report.ts --strict"
  },
  "dependencies": {
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
